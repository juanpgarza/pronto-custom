<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_customer_delivery_tree" model="ir.ui.view">
        <field name="name">report.customer.delivery.tree</field>
        <field name="model">report.customer.delivery</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="warehouse_id"/> <!-- Campo de almacén -->
                <field name="quantity"/>
                <field name="forecasted_quantity"/> <!-- Cantidad pronosticada -->
                <field name="meses_stock"/>
            </tree>
        </field>
    </record>

</odoo>